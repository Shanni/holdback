# Copy to .env and fill in. Test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Merchant admin token for /admin/. If unset, one is generated into data/admin-token.
# ADMIN_TOKEN=

# PORT=4022
# PUBLIC_URL=http://localhost:4022   # used in card-setup links sent to MCP agents
# DATA_DIR=data                      # SQLite database and uploaded images
# ALLOW_LIVE=1                       # required before a live (sk_live_) key is accepted
